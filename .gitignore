/[L|l]ibrary/
/[T|t]emp/
/[O|o]bj/
/[B|b]uild/
/[B|b]uilds/
/[L|l]ogs/
/[U|u]ser[S|s]ettings/
/[M|m]emoryCaptures/
# Unity stages generated Gradle output here during an Android build. The
# hand-authored AndroidManifest.xml is a source file (hand-tracking permission,
# VR intent filter — CLAUDE.md §4.1) and must stay tracked.
/[A|a]ssets/Plugins/Android/*
!/[A|a]ssets/Plugins/Android/AndroidManifest.xml
!/[A|a]ssets/Plugins/Android/AndroidManifest.xml.meta
/[B|b]ackup/

# VS/IDE temp files
.vs/
.idea/
*.csproj
*.sln
*.slnx
*.blob
*.apk
.utmp/
*_BurstDebugInformation_DoNotShip/
*_BackUpThisFolder_ButDontShipItWithYourGame/

# Headless domain build (see DotNet/README.md) — tracked despite the *.csproj / *.sln rules above.
# Unity's own generated *.csproj / *.sln at the repo root stay ignored.
!/DotNet/**/*.csproj
!/DotNet/Jazztures.sln
