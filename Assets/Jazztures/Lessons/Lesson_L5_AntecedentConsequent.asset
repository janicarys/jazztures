  m_Name: Lesson_L5_AntecedentConsequent
  m_EditorClassIdentifier: Jazztures.Lessons::Jazztures.Lessons.LessonDefinition
  _id: L5
  _title: Antecedent–consequent
  _menuDescription: 'The system plays a short musical question. You answer it with your own notes.'
  _conceptExplanation: 
  _conceptSlides:
  - text: 'A tune is like a conversation. First a question, called the antecedent. Then an answer, called the consequent.'
    seconds: 8
  - text: 'The system asks the question. Listen to it. It ends feeling unfinished.'
    seconds: 6
  - text: 'Then it is your turn. Your answer can be anything you like.'
    seconds: 5
  - text: 'Left hand: make the palm-down shape, the home chord, and strike. Right hand: play your notes.'
    seconds: 7
  - text: 'To sound finished, end on the thumb note. That is the home note.'
    seconds: 6
